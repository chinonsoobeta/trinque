# Dish identification. OPENAI_API_KEY is the legacy fallback.
OPENAI_API_KEY_2=
OPENAI_API_KEY=

# Google Places. GOOGLE_PLACES_API_KEY is the legacy fallback.
GCP_API_KEY=
GOOGLE_PLACES_API_KEY=

# Durable relational data (libSQL). Use file:./local.db for a local database;
# TURSO_AUTH_TOKEN is only needed for a remote Turso database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Supabase. Auth uses the publishable key, which is safe in the browser.
# Dish-image and avatar storage uses the service-role key, which bypasses row
# level security and must never reach the client.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Universal links for the iOS app.
APPLE_DEVELOPER_TEAM_ID=

# Extra browser origins allowed through CORS, comma separated. The deployment's
# own origin is always allowed.
TRINQUE_ALLOWED_ORIGINS=

# Identity hashes allowed to reach the moderation surface, comma separated.
TRINQUE_ADMIN_IDENTITY_HASHES=
