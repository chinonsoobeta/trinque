{
  "name": "trinque",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "test:ios": "cd ios && npx tsc --noEmit && npx expo export --platform ios --output-dir dist-ios",
    "verify": "npm test && npm run test:ios",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:check": "node --experimental-strip-types --test tests/migrations.test.mjs tests/persistence.test.mjs",
    "db:generate": "drizzle-kit generate",
    "evaluate:identifier": "node --experimental-strip-types scripts/evaluate-identifier.mjs",
    "db:migrate": "node --experimental-strip-types scripts/migrate.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@supabase/supabase-js": "^2.110.7",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "expo": "^57.0.7",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
